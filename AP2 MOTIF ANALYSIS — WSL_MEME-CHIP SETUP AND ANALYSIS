# =====================================================================
# CONVERT MEME EPS LOGOS TO PNG
#
# MEME generated EPS logos correctly, but automatic PNG generation was
# unreliable in our WSL installation.
#
# Ghostscript is therefore used to convert every EPS motif logo to a
# 300-dpi PNG.
# =====================================================================


while IFS= read -r -d '' logo; do

  gs -dSAFER -dBATCH -dNOPAUSE -dEPSCrop \
    -sDEVICE=pngalpha \
    -r300 \
    -sOutputFile="${logo%.eps}.png" \
    "$logo"

done < <(
  find . \
    -type f \
    -name '*.eps' \
    -print0
)


