  -meme-nmotifs 5 \
  -neg motif_classes/AP2III-1_Nonresponsive_250bp.fa \
  -oc Meme_differential_AP2III-1/Repressed_vs_Nonresponsive \
  motif_classes/AP2III-1_Repressed_250bp.fa


